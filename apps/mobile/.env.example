# Copy these values into --dart-define arguments or your local CI/run script.
# NEVER commit real credentials or a Supabase service_role / Stripe secret key.
# The Flutter app must ONLY receive public client values (anon key + API base URL).

SIRAGRO_ENV=staging
SIRAGRO_API_BASE_URL=https://your-staging-siragro-domain.example
SIRAGRO_SUPABASE_URL=https://your-staging-project.supabase.co
SIRAGRO_SUPABASE_ANON_KEY=your-staging-supabase-anon-key
SIRAGRO_APP_SCHEME=siragro
